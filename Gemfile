source "https://rubygems.org"

# Only what this site needs. GitHub Pages builds with Jekyll 3.10,
# so pinning to 3.10 keeps local previews matching production.
gem "jekyll", "~> 3.10"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"   # page titles + social share tags
end

# Needed for `jekyll serve` on Ruby 3+ (no longer bundled with Ruby)
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "kramdown-parser-gfm"
